PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hospital_appointments
JWT_SECRET=replace_with_a_long_random_string
# Access token lifetime (sent as Bearer header)
ACCESS_TOKEN_EXPIRES_IN=15m
# Refresh token lifetime in days (HTTP-only cookie)
REFRESH_TOKEN_DAYS=7
CLIENT_URL=http://localhost:5173

# Used only by `npm run seed` to create the first admin account
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please

# Optional: Redis connection URL (caching is disabled when empty)
REDIS_URL=
