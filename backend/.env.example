PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hospital_appointments
JWT_SECRET=replace_with_a_long_random_string
CLIENT_URL=http://localhost:5173

# --- Access tokens (Issue #15) ---
# Access tokens are short lived and carry a session id (`sid`). The previous
# JWT_EXPIRES_IN variable no longer applies: refresh tokens are now the long-lived
# credential and live in an HttpOnly cookie.
ACCESS_TOKEN_EXPIRES_IN=15m

# --- Refresh tokens / sessions (Issue #15) ---
# Lifetime of a refresh token (and therefore of one signed-in device).
REFRESH_TOKEN_TTL_DAYS=30
# Grace window that keeps two concurrent refreshes (e.g. two browser tabs) from
# revoking each other's session. Inside the window a duplicate request receives a
# fresh access token but no new refresh token, and no second token chain is created.
# Set to 0 to disable the window and require strict single-flight clients.
REFRESH_TOKEN_GRACE_MS=30000
# Cookie policy. Leave empty for the defaults (sameSite=none + secure in
# production, lax + non-secure in development). SameSite=none is always forced to
# Secure because browsers reject that combination.
REFRESH_COOKIE_SAMESITE=
REFRESH_COOKIE_SECURE=

# --- Waiting-list notification stream (Issue #11) ---
# Lifetime of a single-use ticket used to authorize the Server-Sent Events stream
# (milliseconds). The ticket is consumed by its first use and authorizes nothing else.
SSE_TICKET_TTL_MS=30000
# Upper bound on unexpired tickets kept in memory; the oldest are dropped first.
SSE_MAX_TICKETS=5000
# SSE heartbeat (comment frame) interval in milliseconds. Keep this below the idle
# connection timeout of any proxy in front of the API so open streams are not dropped.
SSE_HEARTBEAT_MS=25000

# --- Deployment ---
# Set to 1 on Render/Vercel so rate limiting and audit records see the real client IP.
TRUST_PROXY=

# Used only by `npm run seed` to create the first admin account
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please

# Optional: Redis connection URL (caching is disabled when empty)
REDIS_URL=
