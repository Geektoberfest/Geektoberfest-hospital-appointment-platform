
# Server Configuration
# Note: Render automatically assigns PORT; in local development, default is 5000
PORT=5000
NODE_ENV=development

# Database Connection
# Local MongoDB: mongodb://127.0.0.1:27017/hospital_appointments
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Remember to allow the backend server's outbound IP addresses in MongoDB Atlas Network Access.
MONGO_URI=mongodb://127.0.0.1:27017/hospital_appointments

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_string

# CORS Allowed Origin
# For local development: http://localhost:5173
# For production (e.g., Vercel): https://hospital-appointment-platform-front.vercel.app
# Multiple origins can be separated by commas
# Example: http://localhost:5173,https://your-domain.vercel.app
CLIENT_URL=http://localhost:5173

# --- Access Tokens (Issue #15) ---
# Access tokens are short lived and carry a session ID (sid).
# JWT_EXPIRES_IN is no longer used.
# Refresh tokens are the long-lived credentials stored in HttpOnly cookies.
ACCESS_TOKEN_EXPIRES_IN=15m

# --- Refresh Tokens / Sessions (Issue #15) ---
# Lifetime of a refresh token and its associated signed-in session.
REFRESH_TOKEN_TTL_DAYS=30

# Grace window for concurrent refresh requests from multiple browser tabs.
# During this window, a duplicate request receives a fresh access token
# without generating a second refresh-token chain.
# Set to 0 to disable the grace window.
REFRESH_TOKEN_GRACE_MS=30000

# Cookie policy.
# Leave empty for automatic defaults:
# Production: SameSite=None, Secure=true
# Development: SameSite=Lax, Secure=false
# SameSite=None requires Secure=true.
REFRESH_COOKIE_SAMESITE=
REFRESH_COOKIE_SECURE=

# --- Waiting-List Notification Stream (Issue #11) ---
# Lifetime of a single-use SSE authorization ticket in milliseconds.
SSE_TICKET_TTL_MS=30000

# Maximum number of unexpired SSE tickets stored in memory.
SSE_MAX_TICKETS=5000

# SSE heartbeat interval in milliseconds.
# Keep below the reverse proxy's idle connection timeout.
SSE_HEARTBEAT_MS=25000

# --- Deployment ---
# Set TRUST_PROXY=1 when deployed behind a trusted reverse proxy,
# such as Render, if the application expects one proxy hop.
# Leave empty for local development.
TRUST_PROXY=

# Admin Seeding
# Used only by `npm run seed` to create the initial admin account.
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please

# Optional: Redis connection URL
# Caching is disabled when empty.
REDIS_URL=
